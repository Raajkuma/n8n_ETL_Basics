    {
      "parameters": {
        "jsCode": "\nreturn $input.all().map(item => {\n  // Find the source text regardless of the field name\n  let raw = item.json.output\n    ?? item.json.text\n    ?? item.json.content\n    ?? item.json.message\n    ?? item.json.response\n    ?? item.json;\n\n  // If the whole input is an object, find its string value\n  if (typeof raw !== \"string\") {\n    const values = Object.values(raw);\n    raw = values.find(value => typeof value === \"string\");\n\n    if (typeof raw !== \"string\") {\n      throw new Error(\n        \"Source text not found. Check the Input panel for the actual field name.\"\n      );\n    }\n  }\n\n  // Decode HTML entities and line breaks\n  raw = raw\n    .replace(/&#x20;/gi, \" \")\n    .replace(/&nbsp;/gi, \" \")\n    .replace(/&quot;/gi, '\"')\n    .replace(/&amp;/gi, \"&\")\n    .replace(/&lt;/gi, \"<\")\n    .replace(/&gt;/gi, \">\")\n    .replace(/<br\\s*\\/?>/gi, \"\\n\");\n\n  // Convert literal \\n into actual line breaks\n  raw = raw.replace(/\\\\n/g, \"\\n\");\n\n  // Remove Markdown code fences\n  raw = raw\n    .replace(/```(?:json)?\\s*/gi, \"\")\n    .replace(/```/g, \"\")\n    .trim();\n\n  // Extract JSON object\n  const start = raw.indexOf(\"{\");\n  const end = raw.lastIndexOf(\"}\");\n\n  if (start === -1 || end < start) {\n    throw new Error(\"Could not find a JSON object in the source text.\");\n  }\n\n  const data = JSON.parse(raw.slice(start, end + 1));\n\n  // Convert names to Title Case\n  function toTitleCase(value) {\n    return value\n      .toLowerCase()\n      .replace(/(^|[\\s'-])([a-z])/g, (match, separator, letter) =>\n        separator + letter.toUpperCase()\n      );\n  }\n\n  // Clean string values and placeholders\n  for (const key of Object.keys(data)) {\n    if (typeof data[key] === \"string\") {\n      const value = data[key].trim();\n\n      data[key] =\n        [\"UNKNOWN\", \"N/A\", \"NULL\"].includes(value.toUpperCase())\n          ? null\n          : value;\n    }\n  }\n\n  // Apply capitalization specifically to Name\n  if (typeof data.Name === \"string\" && data.Name !== null) {\n    data.Name = toTitleCase(data.Name);\n  }\n\n  return { json: data };\n});\n"
      },
